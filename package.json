{
  "name": "agentflow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "build": "pnpm --workspace-concurrency=1 -r build",
    "typecheck": "pnpm --workspace-concurrency=1 -r typecheck",
    "test": "vitest run",
    "test:integration": "vitest run tests/integration",
    "eval:run": "node --import tsx packages/evaluation/src/real-runner.ts",
    "eval:dbos": "node --import tsx packages/evaluation/src/real-runner.ts --systems DBOS --scenarios E0,E1,E2,E5,E7 --trials 30",
    "db:migrate": "tsx packages/db/src/cli.ts",
    "dev:api": "pnpm --filter @agentflow/api dev",
    "dev:worker": "pnpm --filter @agentflow/worker dev",
    "dev:web": "pnpm --filter @agentflow/web dev",
    "eval:simulate": "pnpm --filter @agentflow/evaluation run simulate",
    "eval:demo": "node --import tsx packages/evaluation/src/real-runner.ts --systems A1 --scenarios DEMO --lease-ms 15000",
    "test:gemini-live": "vitest run tests/integration/gemini-live.test.ts",
    "validate:gemini": "node --import tsx packages/harness/src/live-validate.ts",
    "agentflow": "node apps/cli/bin/agentflow.js"
  },
  "devDependencies": {
    "@agentflow/db": "workspace:*",
    "@agentflow/evaluation": "workspace:*",
    "@agentflow/harness": "workspace:*",
    "@agentflow/research": "workspace:*",
    "@agentflow/shared": "workspace:*",
    "@google/genai": "^2.27.0",
    "@types/express": "^5.0.3",
    "@types/node": "^24.7.2",
    "@types/pg": "^8.15.5",
    "bullmq": "^5.61.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "zod": "3.23.8"
  }
}
