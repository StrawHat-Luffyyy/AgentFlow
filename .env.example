DATABASE_URL=postgresql://agentflow:agentflow@localhost:5432/agentflow
TEST_DATABASE_URL=postgresql://agentflow:agentflow@localhost:5432/agentflow_test
REDIS_URL=redis://localhost:6379
API_PORT=3000
WORKER_ID=worker-local-1
WORKER_CONCURRENCY=2
OPERATION_LEASE_MS=15000
ATTEMPT_TIMEOUT_MS=60000
LEASE_HEARTBEAT_MS=5000
OUTBOX_POLL_MS=500
SCHEDULER_POLL_MS=2000
DISPATCH_RECOVERY_MS=10000
OTEL_SERVICE_NAME=agentflow
OTEL_EXPORTER_OTLP_ENDPOINT=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Optional second live provider (OpenAI-compatible Groq API). Workers register it only when the key is set.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Optional prices for run cost budgets (maxCostUsd), USD per 1M tokens, keyed "<provider>/<model>".
# Take values from the provider's current price list; AgentFlow ships no prices. Example:
# AGENTFLOW_MODEL_PRICES={"gemini/gemini-3.5-flash":{"inputPer1M":0,"cachedInputPer1M":0,"outputPer1M":0}}
AGENTFLOW_MODEL_PRICES=

# Required for API startup: provision SHA-256 hashes, never plaintext tokens.
AGENTFLOW_AUTH_CREDENTIALS=[]

# Web UI administrative account (pre-provisions acceptance-owner for web login):
AGENTFLOW_ADMIN_USERNAME=admin
AGENTFLOW_ADMIN_PASSWORD=
